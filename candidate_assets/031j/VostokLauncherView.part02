        selectedCharacterName = selected.name;
        closeCharacterPanel(true);
        invalidate();
    }

    public boolean isCharacterPanelOpen() { return characterPanelOpen || characterPanelProgress > 0.01f; }

    @Override protected void onDraw(Canvas canvas) {
        super.onDraw(canvas);
        if (getWidth() <= 0 || getHeight() <= 0) return;
        drawBackground(canvas);
        prepareUiTransform();
        canvas.save();
        canvas.translate(uiLeft, uiTop);
        canvas.scale(uiScale, uiScale);
        drawBottomFade(canvas);
        drawBrand(canvas);
        drawTopNavigation(canvas);
        drawNewsCard(canvas);
        drawServerCard(canvas);
        drawPlayButton(canvas);
        drawFooter(canvas);
        drawCharacterCard(canvas);
        drawCharacterPanel(canvas);
        canvas.restore();
    }

    private void drawBackground(Canvas canvas) {
        canvas.drawColor(Color.BLACK);
        if (backgroundBitmap == null || backgroundBitmap.isRecycled()) return;
        float bw = backgroundBitmap.getWidth();
        float bh = backgroundBitmap.getHeight();
        bgScale = Math.max(getWidth() / bw, getHeight() / bh);
        float drawW = bw * bgScale;
        float drawH = bh * bgScale;
        bgLeft = (getWidth() - drawW) * 0.5f;
        bgTop = (getHeight() - drawH) * 0.5f;
        RectF dst = new RectF(bgLeft, bgTop, bgLeft + drawW, bgTop + drawH);
        canvas.drawBitmap(backgroundBitmap, null, dst, paint);
    }

    private void prepareUiTransform() {
        uiScale = Math.min(getWidth() / DESIGN_W, getHeight() / DESIGN_H);
        uiLeft = (getWidth() - DESIGN_W * uiScale) * 0.5f;
        uiTop = (getHeight() - DESIGN_H * uiScale) * 0.5f;
    }

    private void drawBottomFade(Canvas canvas) {
        uiPaint.setShader(new LinearGradient(0, DESIGN_H - 180, 0, DESIGN_H,
                Color.argb(0, 0, 0, 0), Color.argb(148, 0, 0, 0), Shader.TileMode.CLAMP));
        canvas.drawRect(0, DESIGN_H - 180, DESIGN_W, DESIGN_H, uiPaint);
        uiPaint.setShader(null);
    }

    private void drawBrand(Canvas canvas) {
        drawText(canvas, "VOSTOK", 56, 110, 72, uiBold, Color.WHITE, Paint.Align.LEFT);
        drawText(canvas, "ROLE PLAY", 60, 150, 18, uiRegular, Color.WHITE, Paint.Align.LEFT);
        drawSpacedText(canvas, "БОЛЬШЕ, ЧЕМ ИГРА", 60, 192, 16, 6.0f, uiRegular, Color.argb(225, 231, 224, 219));
    }

    private void drawTopNavigation(Canvas canvas) {
        float left = 1052, top = 20, right = 1862, bottom = 102;
        RectF shell = new RectF(left, top, right, bottom);
        drawGlassPanel(canvas, shell, 28, Color.argb(112, 40, 28, 24), Color.argb(78, 255, 255, 255));
        drawTopButton(canvas, SITE, siteIcon, "Сайт");
        drawTopButton(canvas, VK, vkIcon, "ВКонтакте");
        drawTopButton(canvas, TELEGRAM, telegramIcon, "Telegram");
        drawTopButton(canvas, SUPPORT, supportIcon, "Поддержка");
        drawTopButton(canvas, SETTINGS, settingsIcon, "Настройки");
    }

    private void drawTopButton(Canvas canvas, RectF rect, Drawable icon, String label) {
        RectF active = label.equals("Поддержка") ? rect : null;
        if (active != null) {
            uiPaint.setStyle(Paint.Style.STROKE);
            uiPaint.setStrokeWidth(1.4f);
            uiPaint.setColor(Color.argb(105, 255, 255, 255));
            canvas.drawRoundRect(active, 18, 18, uiPaint);
        }
        drawIcon(canvas, icon, rect.left + 17, rect.centerY() - 12, 24, 24, 242);
        drawText(canvas, label, rect.left + 49, rect.centerY() + 5, 16, uiRegular, Color.WHITE, Paint.Align.LEFT);
    }

    private void drawNewsCard(Canvas canvas) {
        drawGlassPanel(canvas, NEWS, 28, Color.argb(120, 30, 21, 20), Color.argb(90, 255, 255, 255));
        drawText(canvas, "НОВОСТИ", NEWS.left + 26, NEWS.top + 40, 18, uiBold, Color.WHITE, Paint.Align.LEFT);
        drawText(canvas, "Все новости →", NEWS.right - 24, NEWS.top + 40, 15, uiRegular, Color.argb(225, 255, 255, 255), Paint.Align.RIGHT);
        float y = NEWS.top + 70;
        for (int i = 0; i < NEWS_ITEMS.length; i++) {
            NewsItem item = NEWS_ITEMS[i];
            RectF thumb = new RectF(NEWS.left + 24, y + 4, NEWS.left + 128, y + 95);
            drawThumbPlaceholder(canvas, thumb, i);
            drawText(canvas, item.title, NEWS.left + 146, y + 28, 16, uiBold, Color.WHITE, Paint.Align.LEFT);
            drawMultiline(canvas, item.body, NEWS.left + 146, y + 52, 12, 16, uiRegular, Color.argb(228, 240, 233, 228));
            drawText(canvas, item.date, NEWS.left + 146, y + 82, 12, uiRegular, Color.argb(170, 220, 214, 210), Paint.Align.LEFT);
            y += 112;
        }
    }

    private void drawThumbPlaceholder(Canvas canvas, RectF rect, int index) {
        int[] bases = new int[]{ Color.rgb(84, 77, 92), Color.rgb(66, 82, 76), Color.rgb(43, 63, 82) };
        uiPaint.setShader(new LinearGradient(rect.left, rect.top, rect.right, rect.bottom,
                Color.argb(255, 248, 154, 90), bases[index], Shader.TileMode.CLAMP));
        canvas.drawRoundRect(rect, 18, 18, uiPaint);
        uiPaint.setShader(null);
        uiPaint.setStyle(Paint.Style.STROKE);
        uiPaint.setStrokeWidth(1.3f);
        uiPaint.setColor(Color.argb(145, 255, 255, 255));
        canvas.drawRoundRect(rect, 18, 18, uiPaint);
        uiPaint.setStyle(Paint.Style.FILL);
    }

    private void drawServerCard(Canvas canvas) {
        drawGlassPanel(canvas, SERVER, 24, Color.argb(180, 24, 21, 21), Color.argb(82, 255, 255, 255));
        uiPaint.setColor(Color.rgb(83, 212, 96));
        canvas.drawCircle(SERVER.left + 42, SERVER.centerY(), 8, uiPaint);
        drawText(canvas, "VOSTOK #1", SERVER.left + 68, SERVER.centerY() + 7, 18, uiBold, Color.WHITE, Paint.Align.LEFT);
        drawText(canvas, "742 / 1000", SERVER.left + 212, SERVER.centerY() + 7, 16, uiRegular, Color.argb(232, 236, 233, 230), Paint.Align.LEFT);
        drawIcon(canvas, expandIcon, SERVER.right - 43, SERVER.centerY() - 12, 24, 24, 232);
    }

    private void drawPlayButton(Canvas canvas) {
        RectF rect = PLAY;
        uiPaint.setShader(new LinearGradient(rect.left, rect.top, rect.right, rect.bottom,
                Color.rgb(243, 126, 51), Color.rgb(255, 82, 58), Shader.TileMode.CLAMP));
        canvas.drawRoundRect(rect, 26, 26, uiPaint);
        uiPaint.setShader(null);
        drawIcon(canvas, playIcon, rect.left + 67, rect.centerY() - 22, 44, 44, 255);
        drawText(canvas, "ИГРАТЬ", rect.left + 150, rect.centerY() + 10, 30, uiBold, Color.WHITE, Paint.Align.LEFT);
    }

    private void drawFooter(Canvas canvas) {
        uiPaint.setColor(Color.rgb(71, 205, 92));
        canvas.drawCircle(40, 786, 7, uiPaint);
        drawText(canvas, "Все файлы актуальны", 58, 792, 15, uiRegular, Color.argb(228, 235, 232, 228), Paint.Align.LEFT);
        drawText(canvas, "|", 216, 792, 15, uiRegular, Color.argb(120, 255, 255, 255), Paint.Align.LEFT);
        drawText(canvas, "Версия лаунчера: 0.1.5", 238, 792, 15, uiRegular, Color.argb(228, 235, 232, 228), Paint.Align.LEFT);
        uiPaint.setColor(Color.argb(108, 255, 255, 255));
        canvas.drawRect(1306, 782, 1390, 784, uiPaint);
        drawSpacedText(canvas, "НАСТОЯЩИЕ ГОРОДА. НАСТОЯЩИЕ ЛЮДИ.", 1415, 792, 12, 4.3f, uiRegular, Color.argb(180, 232, 225, 220));
